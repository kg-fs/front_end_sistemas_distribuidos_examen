---
import Layout from '../layouts/Layout.astro';
import HeaderClient from '../components/HeaderClient.tsx';
import ProductGridClient from '../components/ProductGridClient.tsx';
import SessionManager from '../components/SessionManager.tsx';
---

<Layout>
	<SessionManager client:load>
		<HeaderClient client:load />
		<main class="min-h-screen">
		<section class="py-16 bg-white">
			<div class="max-w-6xl mx-auto px-6">
				<h2 class="text-3xl text-[#496B90] text-center mb-16 font-light tracking-wide md:text-2xl">
					Catálogo de Productos
				</h2>
				<ProductGridClient client:load />
			</div>
		</section>
	</main>
	</SessionManager>
</Layout>
