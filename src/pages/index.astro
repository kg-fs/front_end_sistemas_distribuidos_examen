s---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.tsx';
import About from '../components/About.tsx';
import SessionManager from '../components/SessionManager.tsx';
---

<Layout>
	<SessionManager client:load>
		<Header client:load />
		<main class="min-h-screen">
		<Hero />
		
		<!-- Sección About -->
		<About client:load />
		
		<!-- Sección Productos -->
		<section class="py-16 bg-white" id="productos">
			<div class="max-w-6xl mx-auto px-6">
				<h2 class="text-3xl text-[#496B90] text-center mb-16 font-light tracking-wide md:text-2xl">
					Nuestros Productos
				</h2>
				<ProductGrid client:load />
			</div>
		</section>
	</main>
	</SessionManager>
</Layout>
